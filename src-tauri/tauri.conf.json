{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Guilty Spark",
  "version": "0.2.0",
  "identifier": "studio.guiltyspark.editor",
  "build": {
    "beforeDevCommand": "node scripts/run-vite.mjs",
    "beforeBuildCommand": "node scripts/build-web.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Project Guilty Spark — Halo Modern Evolved", "width": 1500, "height": 950, "minWidth": 1100, "minHeight": 720, "backgroundColor": "#0b0f14", "dragDropEnabled": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; font-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "A source-safe Halo 1 modding workbench", "category": "DeveloperTool", "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.icns"], "windows": { "nsis": { "installMode": "currentUser" } } }
}
